<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claude-net.appguard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DIR__/bin/claude-app-guard.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>3</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardErrorPath</key>
  <string>__DIR__/claude-guard.err</string>
</dict>
</plist>
